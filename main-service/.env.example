NODE_ENV=development
PORT=3001

# Database Configuration (Dùng từng biến cho Local hoặc DATABASE_URL cho Neon/Cloud)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_local_password
DB_NAME=fastfood
DB_LOGGING=true
DB_SSL=false
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# JWT Configuration
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis Configuration (Dùng từng biến cho Local hoặc REDIS_URL cho Upstash/Cloud)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
# REDIS_URL=rediss://default:password@your-upstash-redis.upstash.io:6379

# AWS S3 Configuration
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=your_s3_bucket_name
# AWS_S3_ENDPOINT=http://localhost:9000
# AWS_S3_PUBLIC_URL=https://cdn.example.com

# Google OAuth2 Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
FRONTEND_URL=http://localhost:3000
