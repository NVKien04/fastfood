# Backend API Base URL
NEXT_PUBLIC_API_MAIN_URL=http://localhost:3001

# Application Base URL (Frontend)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth Redirect Trigger Endpoint (Tùy chọn ghi đè, mặc định: {NEXT_PUBLIC_API_MAIN_URL}/api/auth/google)
NEXT_PUBLIC_GOOGLE_AUTH_URL=http://localhost:3001/api/auth/google
