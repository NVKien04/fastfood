    "name": "FastFood API - Full Collection",
    "description": "Toàn bộ API cho hệ thống FastFood (Pizza, Burger, Combo, Topping, Order, Auth, etc.)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
