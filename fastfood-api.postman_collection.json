    {
      "name": "2. Products",
      "item": [
        {
          "name": "Danh sách sản phẩm phân trang & Lọc",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"page\": 1,\n  \"limit\": 10,\n  \"search\": \"\",\n  \"categoryId\": 1,\n  \"orderby\": \"sortOrder\",\n  \"orderDirection\": \"ASC\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/product/get-page",
              "host": ["{{baseUrl}}"],
              "path": ["product", "get-page"]
            }
          }
        },
        {
          "name": "Chi tiết sản phẩm theo Slug (SEO)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/product/slug/pizza-hai-san-pesto",
              "host": ["{{baseUrl}}"],
              "path": ["product", "slug", "pizza-hai-san-pesto"]
            }
          }
        },
        {
          "name": "Chi tiết sản phẩm theo ID",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/product/:id",
              "host": ["{{baseUrl}}"],
              "path": ["product", ":id"],
              "variable": [{ "key": "id", "value": "uuid-product-id" }]
            }
          }
        },
        {
          "name": "Sản phẩm liên quan (Cùng danh mục)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/product/:id/related",
              "host": ["{{baseUrl}}"],
              "path": ["product", ":id", "related"],
              "variable": [{ "key": "id", "value": "uuid-product-id" }]
            }
          }
        },
        {
          "name": "Tạo mới sản phẩm (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pizza Thịt Bò Thượng Hạng\",\n  \"slug\": \"pizza-thit-bo-thuong-hang\",\n  \"description\": \"Thịt bò mềm hảo hạng nướng bơ tỏi cùng phô mai Mozzarella\",\n  \"basePrice\": 189000,\n  \"sortOrder\": 1,\n  \"img\": \"https://example.com/pizza-beef.jpg\",\n  \"isFeatured\": 1,\n  \"categoryId\": 1,\n  \"variants\": [\n    {\n      \"name\": \"Nhỏ (20cm) Mỏng\",\n      \"size\": \"20cm\",\n      \"type\": \"nhỏ\",\n      \"modifiedPrice\": 0,\n      \"sortOrder\": 1\n    },\n    {\n      \"name\": \"Lớn (30cm) Vừa\",\n      \"size\": \"30cm\",\n      \"type\": \"vừa\",\n      \"modifiedPrice\": 50000,\n      \"sortOrder\": 2\n    }\n  ],\n  \"ingredients\": [\n    {\n      \"ingredientId\": 1,\n      \"isDefault\": 1,\n      \"quantity\": 1\n    },\n    {\n      \"ingredientId\": 2,\n      \"isDefault\": 0,\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/product",
              "host": ["{{baseUrl}}"],
              "path": ["product"]
            }
          }
        },
        {
          "name": "Cập nhật trạng thái nhanh (Admin)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": 1,\n  \"isFeatured\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/product/:id/status",
              "host": ["{{baseUrl}}"],
              "path": ["product", ":id", "status"],
              "variable": [{ "key": "id", "value": "uuid-product-id" }]
            }
          }
        },
        {
          "name": "Xóa sản phẩm (Admin)",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/product/:id",
              "host": ["{{baseUrl}}"],
              "path": ["product", ":id"],
              "variable": [{ "key": "id", "value": "uuid-product-id" }]
            }
          }
        }
      ]
